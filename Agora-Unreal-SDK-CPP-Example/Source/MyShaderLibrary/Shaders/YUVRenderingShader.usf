#include "/Engine/Public/Platform.ush"

// ============================================================================
// Texture and Sampler Declarations - Compatible with UE4.27 ~ UE5
// ============================================================================

Texture2D YTextureVal;
Texture2D UTextureVal;
Texture2D VTextureVal;
SamplerState YTextureSampler;
SamplerState UTextureSampler;
SamplerState VTextureSampler;

// ============================================================================
// Vertex Shader - YUV Rendering
// ============================================================================

void YUVRenderingVS(
    in float4 InPosition : ATTRIBUTE0,
    in float2 InUV : ATTRIBUTE1,
    out float2 OutUV : TEXCOORD0,
    out float4 OutPosition : SV_POSITION
)
{
    OutPosition = InPosition;
    OutUV = InUV;
}

// ============================================================================
// Pixel Shader - YUV to RGB Conversion
// ============================================================================

void YUVRenderingPS
(
    in float2 UV : TEXCOORD0,
    in float4 Position : SV_POSITION,
    out float4 OutColor : SV_Target0  // For Metal (Mac), and all other RHI
)
{
    // Sample YUV components from textures
    // Y channel: Full range [0, 1]
    // U/V channels: Centered at 0.5, range [-0.5, 0.5]
    
    float ColorY = clamp(YTextureVal.Sample(YTextureSampler, UV.xy).r, 0, 1);
    float ColorU = clamp(UTextureVal.Sample(UTextureSampler, UV.xy).r - 0.5, -0.5, 0.5);
    float ColorV = clamp(VTextureVal.Sample(VTextureSampler, UV.xy).r - 0.5, -0.5, 0.5);
    
    // ITU-R BT.709 YUV to RGB conversion matrix
    // More accurate color conversion for video
    // This matrix is compatible with both UE4.27 and UE5
    
    static const float4x4 YUVToRGBMatrix = float4x4(
        1.0,     0.0,      1.402000f, 0.0,  // R = Y + 1.402*V
        1.0,    -0.344136, -0.714136f, 0.0, // G = Y - 0.344136*U - 0.714136*V
        1.0,     1.772000f, 0.0,      0.0,  // B = Y + 1.772*U
        0.0,     0.0,      0.0,      1.0    // A = 1.0
    );
    
    float4 YUVColor = float4(ColorY, ColorU, ColorV, 1.0);
    
    // Apply YUV to RGB transformation
    OutColor = mul(YUVToRGBMatrix, YUVColor);
    
    // Clamp output to valid range [0, 1]
    OutColor = saturate(OutColor);
    
    // Optional: Apply gamma correction if needed
    // Uncomment the line below for gamma correction (gamma = 1/2.2 ≈ 0.45)
    // OutColor.rgb = pow(OutColor.rgb, 1.0 / 2.2);
}
